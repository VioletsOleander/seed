{
  "vim.easymotion": true,
  "vim.incsearch": true,
  "vim.useCtrlKeys": true,
  "vim.hlsearch": true,
  "vim.insertModeKeyBindings": [
    {
      "before": ["<C-l>"],
      "after": ["<Esc>"]
    }
  ],
  "vim.normalModeKeyBindingsNonRecursive": [
    {
      "before": ["<Leader>", "c"],
      "commands": [":nohl"]
    },
    {
      "before": ["<Leader>", "w"],
      "commands": ["workbench.action.files.save"]
    },
    {
      "before": ["<Leader>", "<CR>"],
      "commands": ["workbench.action.files.save"]
    }
  ],
  "vim.leader": "<space>",
  "workbench.editor.restoreEditors": true,
  "workbench.editor.showTabs": "single",
  "workbench.editor.useModal": "off",
  "workbench.iconTheme": null,
  "workbench.colorTheme": "Dayfox",
  "search.quickOpen.history.filterSortOrder": "recency",
  "explorer.confirmDelete": false,
  "explorer.compactFolders": false,
  "editor.cursorBlinking": "solid",
  "editor.cursorStyle": "line",
  "editor.lineNumbers": "off",
  "editor.inlayHints.enabled": "off",
  "editor.fontSize": 15,
  "editor.fontFamily": "Fira Code Retina, Consolas, monospace",
  "editor.rulers": [110],
  "editor.minimap.renderCharacters": false,
  "editor.lightbulb.enabled": "off",
  "editor.renderLineHighlight": "none",
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.insertSpaces": true,
  "editor.tabSize": 4,
  "editor.detectIndentation": true,
  "[markdown]": {
    "editor.wordWrap": "wordWrapColumn",
    "editor.wordWrapColumn": 110,
    "editor.rulers": [110],
    "editor.defaultFormatter": "dprint.dprint",
    "editor.wordBasedSuggestions": "currentDocument",
    "editor.quickSuggestions": {
      "other": "off",
      "strings": "off",
      "comments": "off"
    }
  },
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.codeActionsOnSave": {
      "source.organizeImports": "always"
    }
  },
  "[json]": {
    "editor.defaultFormatter": "dprint.dprint"
  },
  "[toml]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "tamasfe.even-better-toml"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "dprint.dprint",
    "editor.quickSuggestions": {
      "strings": true
    },
    "editor.suggest.insertMode": "replace"
  },
  "[yaml]": {
    "editor.defaultFormatter": "dprint.dprint",
    "editor.insertSpaces": true,
    "editor.tabSize": 4,
    "editor.autoIndent": "full",
    "editor.quickSuggestions": {
      "other": "on",
      "comments": "on",
      "strings": "on"
    }
  },
  "[lua]": {
    "editor.defaultFormatter": "JohnnyMorganz.stylua"
  },
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer"
  },
  "files.autoSave": "afterDelay",
  "files.readonlyInclude": {
    ".venv/**": true,
    ".pixi/**": true
  },
  "files.insertFinalNewline": true,
  "files.associations": {
    ".bash.template": "shellscript",
    "config.nu.template": "nushell"
  },
  "terminal.integrated.fontFamily": "Fira Code Retina, Fira Code Nerd Font Mono",
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.copyOnSelection": true,
  "terminal.integrated.stickyScroll.enabled": false,
  "terminal.integrated.suggest.enabled": false,
  "terminal.integrated.initialHint": false,
  "terminal.integrated.profiles.windows": {
    "Nushell": {
      "path": "nu.exe",
      "icon": "terminal-bash"
    },
    "PowerShell": {
      "source": "PowerShell",
      "icon": "terminal-powershell"
    },
    "Command Prompt": {
      "path": [
        "${env:windir}\\Sysnative\\cmd.exe",
        "${env:windir}\\System32\\cmd.exe"
      ],
      "args": [],
      "icon": "terminal-cmd"
    },
    "Git Bash": {
      "source": "Git Bash",
      "icon": "terminal-git-bash"
    }
  },
  "terminal.integrated.defaultProfile.windows": "Nushell",
  "terminal.integrated.confirmOnKill": "never",
  "terminal.integrated.hideOnStartup": "whenEmpty",
  "terminal.integrated.allowChords": false,
  "security.workspace.trust.untrustedFiles": "open",
  "git.openRepositoryInParentFolders": "never",
  "extensions.experimental.affinity": {
    "vscodevim.vim": 1,
    "asvetliakov.vscode-neovim": 1
  },
  "markdown.preview.doubleClickToSwitchToEditor": false,
  "markdown.preview.fontFamily": "Inter, SimHei, Microsoft YaHei, sans-serif",
  "markdown.preview.fontSize": 16,
  "markdown.preview.breaks": true,
  "python.languageServer": "None",
  "python.analysis.languageServerMode": "light",
  "python.analysis.typeCheckingMode": "basic",
  "python.analysis.enableColorPicker": false,
  "python.analysis.supportRestructuredText": false,
  "python.analysis.autoFormatStrings": true,
  "ty.disableLanguageServices": false,
  "ty.completions.autoImport": false,
  "evenBetterToml.formatter.allowedBlankLines": 1,
  "evenBetterToml.formatter.columnWidth": 120,
  "evenBetterToml.formatter.trailingNewline": true,
  "json.schemaDownload.trustedDomains": {
    "https://schemastore.azurewebsites.net/": true,
    "https://raw.githubusercontent.com/microsoft/vscode/": true,
    "https://raw.githubusercontent.com/devcontainers/spec/": true,
    "https://www.schemastore.org/": true,
    "https://json.schemastore.org/": true,
    "https://json-schema.org/": true,
    "https://developer.microsoft.com/json-schemas/": true,
    "https://aka.ms/terminal-profiles-schema": true,
    "https://esm.sh/gh/catppuccin/vscode@catppuccin-vsc-v3.18.1/packages/catppuccin-vsc/schemas": true,
    "https://raw.githubusercontent.com/DavidAnson/markdownlint/v0.40.0/schema": true,
    "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/": true,
    "https://biomejs.dev": true
  },
  "chat.viewSessions.orientation": "stacked",
  "chat.viewSessions.enabled": false,
  "cSpell.enabled": false,
  "editor.inlineSuggest.edits.showCollapsed": true,
  "svelte.enable-ts-plugin": true,
  "chat.disableAIFeatures": true,
  "files.eol": "\n",
  "update.mode": "none"
}
